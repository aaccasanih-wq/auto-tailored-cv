# ----------------------------------------------------------------------------
# auto-tailored-cv - environment configuration template
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored and MUST NEVER be committed.
#
# Default workflow uses Jinja2 + Playwright to render HTML and PDF (no
# LibreOffice needed). Browser-MCP replaced by Playwright MCP.
# ----------------------------------------------------------------------------

# --- LLM (provider-agnostic OpenAI-compatible endpoint) ---
# LLM_API_KEY accepts any endpoint compatible with the OpenAI Chat
# Completions API. Examples of valid LLM_BASE_URL values:
#   OpenCode Go : https://opencode.ai/zen/go/v1   (default; includes glm-5.2)
#   DeepSeek    : https://api.deepseek.com/v1
#   OpenRouter  : https://openrouter.ai/api/v1
# REQUIRED. Your LLM provider API key.
LLM_API_KEY=your-llm-api-key-here

# OpenAI-compatible base URL (no trailing slash).
LLM_BASE_URL=https://opencode.ai/zen/go/v1

# Model used for the rewriting pass. GLM 5.2 is included in OpenCode Go.
LLM_MODEL_TAILOR=glm-5.2

# Model used for the evaluation + repair pass. Same model for consistency.
LLM_MODEL_EVALUATOR=glm-5.2

# Optional per-request timeouts (seconds).
LLM_REQUEST_TIMEOUT=120

# --- Scraper backend ---
# Default: "playwright" (Playwright MCP with auto-wait).
# Fallback: "browsermcp" (legacy Browser MCP + Chrome extension).
SCRAPER_BACKEND=playwright

# Playwright MCP — NPM command that launches @playwright/mcp.
PLAYWRIGHT_MCP_COMMAND=npx
PLAYWRIGHT_MCP_ARGS=-y @playwright/mcp@latest

# Persistent user-data-dir for Playwright Chromium. Stores the LinkedIn login
# so re-runs don't force you to log in again. Path is relative to the project
# root. KEEP THIS DIRECTORY GITIGNORED — it contains cookies.
PLAYWRIGHT_USER_DATA_DIR=.playwright-profile

# Browser MCP (legacy fallback) — NPM command that launches the local MCP server.
# Use @browsermcp/mcp@latest to always get the freshest tools. The Chrome
# extension must be installed and connected for automation to work.
BROWSER_MCP_COMMAND=npx
BROWSER_MCP_ARGS=-y @browsermcp/mcp@latest

# --- LinkedIn / Browser MCP ---

# URL of your saved jobs page. Change only if LinkedIn changes the path.
LINKEDIN_SAVED_JOBS_URL=https://www.linkedin.com/my-items/saved-jobs/

# How long to wait for each navigation action (ms).
BROWSER_TIMEOUT_MS=15000

# Seconds to wait after each browser_navigate before calling browser_snapshot.
# Tune up if you see slow-loading LinkedIn pages on slow networks. With
# Playwright MCP you can drop this to ~1-2 because browser_wait_for handles
# the auto-wait natively.
BROWSER_NAV_DELAY_S=3

# --- Filesystem paths ---
# Path to your base CV (HTML, plain text + hyperlinks; no images).
# The legacy .docx files in input/ are historical; the pipeline does not read
# them anymore (use --legacy-docx to render via the old writer if needed).
BASE_CV_PATH=input/base_cv.html

# Cache directory for extracted job JSONs (gitignored).
JOBS_DIR=jobs

# Directory where tailored CVs are written (gitignored).
OUTPUT_DIR=output

# Jinja templates directory (cv_template.html, cv_style.css).
TEMPLATES_DIR=templates

# --- PDF conversion (legacy path only: --legacy-docx) ---
# Path to the LibreOffice `soffice` binary. Only used by `--legacy-docx`.
# On macOS with the official DMG: /Applications/LibreOffice.app/Contents/MacOS/soffice
# macOS with LibreOffice installed via scripts/install_libreoffice.sh:
SOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice
# Fallback if `soffice` is already on your PATH (eg. brew --cask):
# SOFFICE_PATH=soffice

# --- Review server (`python run.py review <job_slug>`) ---
REVIEW_HOST=localhost
REVIEW_PORT=8420

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO