# ----------------------------------------------------------------------------
# auto-tailored-cv - environment configuration template
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored and MUST NEVER be committed.
#
# How to get OPENCODE_API_KEY:
#   1. Sign in at https://opencode.ai/auth
#   2. Subscribe to OpenCode Go ($5 first month, $10/month after)
#   3. Copy your API key from the console
# ----------------------------------------------------------------------------

# --- LLM (OpenCode Go) ---
# REQUIRED. Your OpenCode API key.
OPENCODE_API_KEY=your-opencode-api-key-here

# Browser MCP — which NPM command launches the local MCP server.
# Use @browsermcp/mcp@latest to always get the freshest tools. The Chrome
# extension must be installed and connected for automation to work.
BROWSER_MCP_COMMAND=npx
BROWSER_MCP_ARGS=-y @browsermcp/mcp@latest

# OpenCode Go OpenAI-compatible base URL (no trailing slash).
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

# Model used for the rewriting pass. GLM 5.2 is included in OpenCode Go.
OPENCODE_MODEL_TAILOR=glm-5.2

# Model used for the evaluation + repair pass. Same model for consistency.
OPENCODE_MODEL_EVALUATOR=glm-5.2

# Optional per-request timeouts (seconds).
OPENCODE_REQUEST_TIMEOUT=120

# --- LinkedIn / Browser MCP ---
# URL of your saved jobs page. Change only if LinkedIn changes the path.
LINKEDIN_SAVED_JOBS_URL=https://www.linkedin.com/my-items/saved-jobs/

# How long to wait for each Browser MCP navigation action (ms).
BROWSER_TIMEOUT_MS=15000

# Seconds to wait after each browser_navigate before calling browser_snapshot.
# Tune up if you see slow-loading LinkedIn pages on slow networks.
BROWSER_NAV_DELAY_S=3

# --- Filesystem paths ---
# Path to your base CV. This file is gitignored.
BASE_CV_PATH=input/base_cv.docx

# Cache directory for extracted job JSONs (gitignored).
JOBS_DIR=jobs

# Directory where tailored CVs are written (gitignored).
OUTPUT_DIR=output

# --- PDF conversion ---
# Path to the LibreOffice `soffice` binary. Default works after `install_libreoffice.sh`.
# On macOS with the official DMG: /Applications/LibreOffice.app/Contents/MacOS/soffice
# macOS with LibreOffice installed via scripts/install_libreoffice.sh:
SOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice
# Fallback if `soffice` is already on your PATH (eg. brew --cask):
# SOFFICE_PATH=soffice

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO